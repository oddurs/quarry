---
import { Badge } from "@/components/ui/badge";
---

<section class="mx-auto max-w-5xl px-6 py-16">
  <Badge variant="secondary">v0.1.0</Badge>

  <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
    Every server running on this machine
  </h1>

  <p class="text-muted-foreground mt-4 max-w-2xl text-lg">
    A terminal dashboard for every port, socket and container listening on your
    machine, grouped by the project it came from.
  </p>
</section>
