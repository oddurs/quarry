---
import BaseLayout from "@/layouts/base-layout.astro";
import FeatureGrid from "@/components/feature-grid.astro";
import Hero from "@/components/hero.astro";
import InstallCommands from "@/components/install-commands.astro";
import SiteFooter from "@/components/site-footer.astro";
import SiteHeader from "@/components/site-header.astro";
import TerminalPreview from "@/components/terminal-preview.astro";
---

<BaseLayout
  title="quarry — every server running on this machine"
  description="A terminal dashboard for every port, socket and container listening on your machine, grouped by the project it came from."
>
  <SiteHeader />
  <main>
    <Hero />
    <TerminalPreview />
    <InstallCommands />
    <FeatureGrid />
  </main>
  <SiteFooter />
</BaseLayout>
