#!/usr/bin/env bash
# Make the checks impossible to skip by accident.
set -euo pipefail

cd "$(dirname "$0")/.."
hooks="$(git rev-parse --git-path hooks)"
mkdir -p "$hooks"

cat > "$hooks/pre-push" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/scripts/check"
HOOK
chmod +x "$hooks/pre-push"

echo "installed pre-push hook -> scripts/check"
